# syntax=docker/dockerfile:1
FROM node:20-slim

LABEL maintainer="Crowd Monitoring Team"
LABEL description="Crowd Monitoring Dashboard (Node.js + Express)"

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY admin/ ./admin/
COPY public/ ./public/
COPY server.js ./

EXPOSE 3000

CMD ["node", "server.js"]